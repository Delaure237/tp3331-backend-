{
  "compilerOptions": {
    "target": "es2020", // Un target moderne est bon

    // ➡️ CORRIGÉ : Bascule en CommonJS simple et stable
    "module": "commonjs",
    "moduleResolution": "node", // Utilise la résolution de module standard Node.js
    "esModuleInterop": true, // Très important pour les imports/exports CJS/ESM

    // 🛑 SUPPRIMÉ/IGNORÉ : Les options ESM strictes
    // "module": "nodenext",
    // "moduleResolution": "NodeNext",

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,

    // Non nécessaires en CJS :
    // "verbatimModuleSyntax": true,
    // "isolatedModules": true,
    // "noUncheckedSideEffectImports": true,
    // "moduleDetection": "force",

    "skipLibCheck": true
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"]
}